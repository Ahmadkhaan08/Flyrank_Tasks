# Base URL for the catalogue pages
BASE_URL=https://books.toscrape.com/catalogue/

# Contact header sent with every request so the site owner can identify us
USER_AGENT=FlyRankInternship-A9/1.0 (+https://github.com/your-username/repo)

# How long to wait for a response, in milliseconds
TIMEOUT_MS=10000

# How long to wait between requests, in milliseconds
DELAY_MS=2000
